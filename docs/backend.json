{
  "entities": {
    "Destination": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Destination",
      "type": "object",
      "description": "Represents a travel destination.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Destination entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the destination."
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the destination."
        },
        "imageUrl": {
          "type": "string",
          "description": "URL of the image showcasing the destination.",
          "format": "uri"
        },
        "videoUrl": {
          "type": "string",
          "description": "URL of the video showcasing the destination.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "imageUrl"
      ]
    },
    "TourPackage": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "TourPackage",
      "type": "object",
      "description": "Represents a curated tour package.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the TourPackage entity."
        },
        "destinationId": {
          "type": "string",
          "description": "Reference to Destination. (Relationship: Destination 1:N TourPackage)"
        },
        "name": {
          "type": "string",
          "description": "Name of the tour package."
        },
        "description": {
          "type": "string",
          "description": "Detailed itinerary and description of the tour package."
        },
        "price": {
          "type": "number",
          "description": "Price of the tour package."
        },
        "duration": {
          "type": "string",
          "description": "Duration of the tour (e.g., '7 days')."
        },
        "image": {
          "type": "object",
          "description": "Image object for the tour package.",
          "properties": {
            "imageUrl": {
              "type": "string",
              "format": "uri",
              "description": "URL of the image representing the tour package."
            },
            "imageHint": {
              "type": "string",
              "description": "Hint for AI image generation or search."
            }
          },
          "required": ["imageUrl"]
        }
      },
      "required": [
        "id",
        "destinationId",
        "name",
        "description",
        "price",
        "duration",
        "image"
      ]
    },
    "Booking": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Booking",
      "type": "object",
      "description": "Represents a user booking for a tour package.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the user making the booking."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user making the booking.",
          "format": "email"
        },
        "tourPackageId": {
          "type": "string",
          "description": "Reference to TourPackage."
        },
        "tourPackageName": {
          "type": "string",
          "description": "Name of the tour package being booked."
        },
        "bookingDate": {
          "type": "string",
          "description": "Date and time when the booking was made.",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "email",
        "tourPackageId",
        "tourPackageName",
        "bookingDate"
      ]
    },
    "Review": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Review",
      "type": "object",
      "description": "Represents a user review and rating for a completed tour package.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Review entity."
        },
        "tourPackageId": {
          "type": "string",
          "description": "Reference to TourPackage. (Relationship: TourPackage 1:N Review)"
        },
        "userName": {
          "type": "string",
          "description": "Name of the user who wrote the review."
        },
        "rating": {
          "type": "number",
          "description": "Rating given by the user (e.g., 1 to 5 stars)."
        },
        "comment": {
          "type": "string",
          "description": "Textual comment provided by the user."
        },
        "reviewDate": {
          "type": "string",
          "description": "Date when the review was submitted.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tourPackageId",
        "userName",
        "rating",
        "comment",
        "reviewDate"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "collections": [
      {
        "path": "/destinations/{destinationId}",
        "schema": {
          "$ref": "#/entities/Destination"
        },
        "description": "Stores travel destination details."
      },
      {
        "path": "/tour_packages/{tourPackageId}",
        "schema": {
          "$ref": "#/entities/TourPackage"
        },
        "description": "Stores curated tour package details."
      },
      {
        "path": "/bookings/{bookingId}",
        "schema": {
          "$ref": "#/entities/Booking"
        },
        "description": "Stores user booking information."
      },
      {
        "path": "/reviews/{reviewId}",
        "schema": {
          "$ref": "#/entities/Review"
        },
        "description": "Stores user reviews for tour packages."
      }
    ]
  }
}

    