/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing strict authorization checks while allowing flexible data shapes for rapid prototyping.  It uses an owner-based access control model for all collections.
 *
 * Data Structure:
 * - /destinations/{destinationId}: Stores travel destination details.
 * - /tour_packages/{tourPackageId}: Stores curated tour package details.
 * - /bookings/{bookingId}: Stores user booking information.
 * - /reviews/{reviewId}: Stores user reviews for tour packages.
 *
 * Key Security Decisions:
 * - All collections enforce owner-only write access. There are no public write permissions.
 * - List operations are generally public but can be restricted as needed.
 *
 * Denormalization for Authorization:
 * - The current data model lacks an explicit 'ownerId' or 'authorId' field in the `TourPackage` schema. To enforce owner-only writes, we need to add this field. In the interim, writes are disabled.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the 'destinations' collection.
     * @path /destinations/{destinationId}
     * @allow (get, list): Anyone can read destination details.
     * @allow (create, update, delete): Only the owner can modify destination details. The owner is not currently defined, so writes are disabled.
     * @deny (create, update, delete): If the user is not the owner (once the owner is defined).
     * @principle Enforces owner-only write access.
     */
    match /destinations/{destinationId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn(); // Only signed-in users can create, update, or delete
    }

    /**
     * @description Controls access to the 'tour_packages' collection.
     * @path /tour_packages/{tourPackageId}
     * @allow (get, list): Anyone can read tour package details.
     * @allow (create, update, delete): Only the owner can modify tour package details. The owner is not currently defined, so writes are disabled.
     * @deny (create, update, delete): If the user is not the owner (once the owner is defined).
     * @principle Enforces owner-only write access.
     */
    match /tour_packages/{tourPackageId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn(); // Only signed-in users can create, update, or delete
    }

    /**
     * @description Controls access to the 'bookings' collection.
     * @path /bookings/{bookingId}
     * @allow (get, list): Anyone can read booking details.
     * @allow (create, update, delete): Only the owner can modify booking details. The owner is not currently defined, so writes are disabled.
     * @deny (create, update, delete): If the user is not the owner (once the owner is defined).
     * @principle Enforces owner-only write access.
     */
    match /bookings/{bookingId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn(); // Only signed-in users can create, update, or delete
    }

    /**
     * @description Controls access to the 'reviews' collection.
     * @path /reviews/{reviewId}
     * @allow (get, list): Anyone can read review details.
     * @allow (create, update, delete): Only the owner can modify review details. The owner is not currently defined, so writes are disabled.
     * @deny (create, update, delete): If the user is not the owner (once the owner is defined).
     * @principle Enforces owner-only write access.
     */
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn(); // Only signed-in users can create, update, or delete
    }

    function isSignedIn() {
        return request.auth != null;
    }
  }
}