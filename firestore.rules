/**
 * @fileoverview Firestore Security Rules for Prestige Bali application.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by default, restricting access to data
 * unless explicitly allowed. It uses flexible access control patterns to
 * balance security with ease of development in this prototyping phase.
 * Schema validation is intentionally relaxed to facilitate rapid iteration.
 *
 * Data Structure:
 * The Firestore database consists of four top-level collections:
 * - /destinations/{destinationId}: Stores information about travel destinations.
 * - /tour_packages/{tourPackageId}: Stores details about curated tour packages.
 * - /bookings/{bookingId}: Stores user booking information.
 * - /reviews/{reviewId}: Stores user reviews for tour packages.
 *
 * Key Security Decisions:
 * - Public Read Access: The destinations and tour_packages collections are readable by anyone.
 * - Restricted Writes: Writes to all collections are disallowed unless the correct validation steps are implemented (e.g. a review is written to a tour package).
 * - No User Listing: Listing all users is not permitted.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read Destinations, but restricts writes.
     * @path /destinations/{destinationId}
     * @allow (get, list): if true
     * @deny (create, update, delete): if false
     * @principle Public read, restricted write.
     */
    match /destinations/{destinationId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read TourPackages, but restricts writes.
     * @path /tour_packages/{tourPackageId}
     * @allow (get, list): if true
     * @deny (create, update, delete): if false
     * @principle Public read, restricted write.
     */
    match /tour_packages/{tourPackageId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Restricts read and write access to bookings.
     * @path /bookings/{bookingId}
     * @allow (get, list): if false
     * @allow (create, update, delete): if false
     */
    match /bookings/{bookingId} {
      allow get, list: if false;
      allow create, update, delete: if false;
    }

    /**
     * @description Restricts read and write access to reviews.
     * @path /reviews/{reviewId}
     * @allow (get, list): if false
     * @allow (create, update, delete): if false
     */
    match /reviews/{reviewId} {
      allow get, list: if false;
      allow create, update, delete: if false;
    }
  }
}