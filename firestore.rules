/**
 * @fileoverview Firestore Security Rules for Prestige Bali application.
 *
 * Core Philosophy:
 * This ruleset provides open read access for all collections to allow for quick prototyping.
 * All write operations require a valid user to be signed in. However, it does not enforce any ownership or role-based
 * access control.
 *
 * Data Structure:
 * - /destinations/{destinationId}: Stores destination data.
 * - /tour_packages/{tourPackageId}: Stores tour package data.
 * - /bookings/{bookingId}: Stores booking data.
 * - /reviews/{reviewId}: Stores review data.
 *
 * Key Security Decisions:
 * - Open read access is granted to all collections for the purpose of prototyping.
 * - All write operations require a signed-in user but lack specific authorization.
 *
 * WARNING: These rules are for prototyping only and are not secure for production use.
 *          Implement ownership or role-based access control before deploying to production.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read destinations. Requires authentication for write operations.
     * @path /destinations/{destinationId}
     * @allow (get, list): if true
     * @allow (create, update, delete): if isSignedIn()
     * @deny (create): if !isSignedIn()
     * @deny (update): if !isSignedIn()
     * @deny (delete): if !isSignedIn()
     * @principle Open read access, authenticated writes.
     */
    match /destinations/{destinationId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows anyone to read tour packages. Requires authentication for write operations.
     * @path /tour_packages/{tourPackageId}
     * @allow (get, list): if true
     * @allow (create, update, delete): if isSignedIn()
     * @deny (create): if !isSignedIn()
     * @deny (update): if !isSignedIn()
     * @deny (delete): if !isSignedIn()
     * @principle Open read access, authenticated writes.
     */
    match /tour_packages/{tourPackageId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows anyone to read bookings. Requires authentication for write operations.
     * @path /bookings/{bookingId}
     * @allow (get, list): if true
     * @allow (create, update, delete): if isSignedIn()
     * @deny (create): if !isSignedIn()
     * @deny (update): if !isSignedIn()
     * @deny (delete): if !isSignedIn()
     * @principle Open read access, authenticated writes.
     */
    match /bookings/{bookingId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows anyone to read reviews. Requires authentication for write operations.
     * @path /reviews/{reviewId}
     * @allow (get, list): if true
     * @allow (create, update, delete): if isSignedIn()
     * @deny (create): if !isSignedIn()
     * @deny (update): if !isSignedIn()
     * @deny (delete): if !isSignedIn()
     * @principle Open read access, authenticated writes.
     */
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }

  function isSignedIn() {
    return request.auth != null;
  }
}