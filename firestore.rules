/**
 * @file Firebase Security Rules for Prestige Bali application.
 *
 * @core_philosophy This ruleset enforces public read access for destinations and tour packages,
 * while restricting write access to authenticated users. Bookings and reviews are also publicly readable,
 * but writes are only allowed for authenticated users.  Schema validation is relaxed to allow for rapid prototyping.
 *
 * @data_structure The Firestore database consists of four top-level collections: `destinations`, `tour_packages`, `bookings`, and `reviews`.
 * Destinations and tour packages can be read by anyone, while bookings and reviews are open for read but only allow authenticated users to write.
 *
 * @key_security_decisions
 *   - Public read access to destinations and tour packages is granted to allow easy browsing.
 *   - Write access is restricted to authenticated users.
 *   - No listing restrictions are imposed for prototyping, but consider adding them in production.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to destinations, but restricts write access to authenticated users.
     * @path /destinations/{destinationId}
     * @allow (get, list) - Any user can read destination data.
     * @allow (create) - Any authenticated user can create destination data.
     * @allow (update, delete) - No user can update or delete destination data (explicitly denied).
     * @deny (create) - An unauthenticated user attempts to create a destination.
     * @principle Allows public data browsing while restricting modifications.
     */
    match /destinations/{destinationId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Grants public read access to tour packages, but restricts write access to authenticated users.
     * @path /tour_packages/{tourPackageId}
     * @allow (get, list) - Any user can read tour package data.
     * @allow (create) - Any authenticated user can create tour package data.
     * @allow (update, delete) - No user can update or delete tour package data (explicitly denied).
     * @deny (create) - An unauthenticated user attempts to create a tour package.
     * @principle Allows public data browsing while restricting modifications.
     */
    match /tour_packages/{tourPackageId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Grants public read access to bookings, but restricts write access to authenticated users.
     * @path /bookings/{bookingId}
     * @allow (get, list) - Any user can read booking data.
     * @allow (create) - Any authenticated user can create booking data.
     * @allow (update, delete) - No user can update or delete booking data (explicitly denied).
     * @deny (create) - An unauthenticated user attempts to create a booking.
     * @principle Allows public data browsing while restricting modifications.
     */
    match /bookings/{bookingId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Grants public read access to reviews, but restricts write access to authenticated users.
     * @path /reviews/{reviewId}
     * @allow (get, list) - Any user can read review data.
     * @allow (create) - Any authenticated user can create review data.
     * @allow (update, delete) - No user can update or delete review data (explicitly denied).
     * @deny (create) - An unauthenticated user attempts to create a review.
     * @principle Allows public data browsing while restricting modifications.
     */
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}