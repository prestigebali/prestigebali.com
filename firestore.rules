/**
 * @fileoverview Firestore Security Rules for Prestige Bali application.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing strict access controls based on
 * clearly defined patterns for each data collection.  It defaults to a secure posture,
 * explicitly denying access where the intent isn't clear, or the data model lacks
 * the necessary information for secure authorization.  Data shape validation is
 * relaxed to enable rapid prototyping.
 *
 * Data Structure:
 * - /settings/global:  Contains global site settings (single document).
 * - /destinations/{destinationId}: Stores travel destinations.
 * - /tour_packages/{tourPackageId}: Stores tour packages.
 * - /bookings/{bookingId}: Stores booking information.
 * - /reviews/{reviewId}: Stores tour package reviews.
 *
 * Key Security Decisions:
 * - Public Read, Restricted Write: /destinations, /tour_packages, and /reviews are publicly readable but require authentication for writes.
 *   A critical precondition for this pattern is the existence of an `ownerId` or similar
 *   field in the document schema. The absence of such a field results in the write rules
 *   being disabled.
 * - Bookings are publicly accessible.
 * - The `SiteSettings` collection is read and write restricted to authenticated users.
 *
 * Denormalization for Authorization:
 * N/A - Currently, authorization is based on simple checks. More complex scenarios (e.g., shared access)
 * would benefit from denormalizing access control data directly into the documents.
 *
 * Structural Segregation:
 * N/A - There's no need to segregate public and private data, as the app doesn't explicitly
 * define drafts versus published content.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants read/write access to global site settings only for authenticated users.
     * @path /settings/global
     * @allow (get, list): if isSignedIn()
     * @allow (create, update, delete): if isSignedIn()
     * @deny (get, list): if !isSignedIn()
     * @deny (create, update, delete): if !isSignedIn()
     * @principle Requires authentication for any operations on site settings.
     */
    match /settings/global {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows public read access to destinations and restricts writes.
     * @path /destinations/{destinationId}
     * @allow (get, list): if true
     * @deny (create, update, delete): if false
     * @principle Public read, restricted write for destinations.
     */
    match /destinations/{destinationId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows public read access to tour packages and restricts writes.
     * @path /tour_packages/{tourPackageId}
     * @allow (get, list): if true
     * @deny (create, update, delete): if false
     * @principle Public read, restricted write for tour packages.
     */
    match /tour_packages/{tourPackageId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows public read and write access to bookings.
     * @path /bookings/{bookingId}
     * @allow (get, list, create, update, delete): if true
     * @principle Public read and write access to bookings.
     */
    match /bookings/{bookingId} {
      allow get, list, create, update, delete: if true;
    }

    /**
     * @description Allows public read access to reviews and restricts writes.
     * @path /reviews/{reviewId}
     * @allow (get, list): if true
     * @deny (create, update, delete): if false
     * @principle Public read, restricted write for reviews.
     */
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}