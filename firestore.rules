/**
 * @fileoverview Firestore Security Rules for Prestige Bali application.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by strictly controlling access to data.
 * It uses a combination of public read access for some collections and
 * authenticated user-only write access.
 *
 * Data Structure:
 * - `/settings/global`:  Stores global site settings (e.g., contact info).
 * - `/destinations/{destinationId}`: Stores destination details.
 * - `/tour_packages/{tourPackageId}`: Stores tour package details.
 * - `/bookings/{bookingId}`: Stores booking information.
 * - `/reviews/{reviewId}`: Stores tour package reviews.
 *
 * Key Security Decisions:
 * - Site settings are publicly readable, but only authenticated users can modify them.
 * - Destinations, tour packages and reviews are publicly readable. Only authenticated users can create, update, or delete them.
 * - Bookings are writeable by any authenticated user.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to global website settings, but requires
     *              authentication for any modifications.
     * @path /settings/global
     * @allow (get, list): Always allowed for all users, including unauthenticated.
     * @allow (create, update, delete): Only allowed for authenticated users.
     * @deny  (create, update, delete): Denied for unauthenticated users.
     * @principle Public read, authenticated write.
     */
    match /settings/global {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows public read access to destination details, but requires
     *              authentication for any modifications.
     * @path /destinations/{destinationId}
     * @allow (get, list): Always allowed for all users, including unauthenticated.
     * @allow (create, update, delete): Only allowed for authenticated users.
     * @deny  (create, update, delete): Denied for unauthenticated users.
     * @principle Public read, authenticated write.
     */
    match /destinations/{destinationId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows public read access to tour package details, but requires
     *              authentication for any modifications.
     * @path /tour_packages/{tourPackageId}
     * @allow (get, list): Always allowed for all users, including unauthenticated.
     * @allow (create, update, delete): Only allowed for authenticated users.
     * @deny  (create, update, delete): Denied for unauthenticated users.
     * @principle Public read, authenticated write.
     */
    match /tour_packages/{tourPackageId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to create bookings.
     * @path /bookings/{bookingId}
     * @allow (create): Only allowed for authenticated users.
     * @allow (get, list, update, delete): Denied for all users.
     * @deny  (create): Denied for unauthenticated users.
     * @principle Authenticated users can create bookings.
     */
    match /bookings/{bookingId} {
      allow get, list, update, delete: if false;
      allow create: if isSignedIn();
    }

    /**
     * @description Allows public read access to reviews, but requires
     *              authentication for any modifications.
     * @path /reviews/{reviewId}
     * @allow (get, list): Always allowed for all users, including unauthenticated.
     * @allow (create, update, delete): Only allowed for authenticated users.
     * @deny  (create, update, delete): Denied for unauthenticated users.
     * @principle Public read, authenticated write.
     */
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }


    // Helper function to determine if a user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }
  }
}