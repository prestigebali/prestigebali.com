/**
 * @file Overview
 * This ruleset enforces a public read, owner-write model for destinations, tour packages, bookings, and reviews.
 *
 * Data Structure:
 * The database contains top-level collections for destinations, tour packages, bookings, and reviews.
 *  /destinations/{destinationId}
 *  /tour_packages/{tourPackageId}
 *  /bookings/{bookingId}
 *  /reviews/{reviewId}
 *
 * Key Security Decisions:
 * - Destinations, TourPackages, Bookings, and Reviews are publicly readable.
 * - Only authenticated users can create, update, or delete destinations, tour packages, bookings, or reviews,
 *   and they can only modify documents where they are the owner (i.e., the 'ownerId' field matches their UID).
 * - It's currently assumed that the 'id' in each document refers to the userId of the document owner. This allows
 *   simplified authorization checks.
 *
 * Denormalization for Authorization:
 *  - The 'id' field is used as the 'ownerId' and must match the authenticated user's UID. This avoids needing separate
 *    queries to determine ownership.
 *
 * Structural Segregation:
 *  - N/A. This database does not segregate data based on privacy levels.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to destinations, but restricts writes to the owner.
     * @path /destinations/{destinationId}
     * @allow (get, list): Any user can read destination details.
     * @allow (create): Authenticated user can create a destination if the 'id' field matches their UID.
     * @allow (update, delete): Authenticated user can update/delete a destination if they are the owner (i.e., 'id' field matches their UID) and the document exists.
     * @deny create: if request.resource.data.id != request.auth.uid; //Example deny condition - Owner does not match auth uid
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /destinations/{destinationId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.id == request.auth.uid;
      allow update, delete: if isExistingOwner(resource.data.id);
    }

    /**
     * @description Allows public read access to tour packages, but restricts writes to the owner.
     * @path /tour_packages/{tourPackageId}
     * @allow (get, list): Any user can read tour package details.
     * @allow (create): Authenticated user can create a tour package if the 'id' field matches their UID.
     * @allow (update, delete): Authenticated user can update/delete a tour package if they are the owner (i.e., 'id' field matches their UID) and the document exists.
     * @deny create: if request.resource.data.id != request.auth.uid; //Example deny condition - Owner does not match auth uid
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /tour_packages/{tourPackageId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.id == request.auth.uid;
      allow update, delete: if isExistingOwner(resource.data.id);
    }

    /**
     * @description Allows public read access to bookings, but restricts writes to the owner.
     * @path /bookings/{bookingId}
     * @allow (get, list): Any user can read booking details.
     * @allow (create): Authenticated user can create a booking if the 'id' field matches their UID.
     * @allow (update, delete): Authenticated user can update/delete a booking if they are the owner (i.e., 'id' field matches their UID) and the document exists.
     * @deny create: if request.resource.data.id != request.auth.uid; //Example deny condition - Owner does not match auth uid
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /bookings/{bookingId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isExistingOwner(resource.data.id);
    }

    /**
     * @description Allows public read access to reviews, but restricts writes to the owner.
     * @path /reviews/{reviewId}
     * @allow (get, list): Any user can read review details.
     * @allow (create): Authenticated user can create a review if the 'id' field matches their UID.
     * @allow (update, delete): Authenticated user can update/delete a review if they are the owner (i.e., 'id' field matches their UID) and the document exists.
     * @deny create: if request.resource.data.id != request.auth.uid; //Example deny condition - Owner does not match auth uid
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.id == request.auth.uid;
      allow update, delete: if isExistingOwner(resource.data.id);
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}