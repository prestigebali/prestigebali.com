/**
 * @fileoverview Firestore Security Rules for the Tour Package Booking App.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing strict access control to Firestore data.
 * Read access is generally public for core data (destinations, tour packages), while writes are restricted.
 * User-generated content (bookings, reviews) can be created by any authenticated user.
 *
 * Data Structure:
 * - /destinations/{destinationId}: Stores destination information.
 * - /tour_packages/{tourPackageId}: Stores tour package details.
 * - /bookings/{bookingId}: Stores booking information.
 * - /reviews/{reviewId}: Stores user reviews for tour packages.
 *
 * Key Security Decisions:
 * - Public read access for destinations and tour packages to allow browsing without authentication.
 * - Bookings and reviews can be created by any logged-in user, reflecting an open contribution model.
 * - No listing of bookings or reviews is allowed to prevent data scraping.
 * - No update/delete operations are allowed on bookings.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to destination details. Write access is not allowed.
     * @path /destinations/{destinationId}
     * @allow get, list: if true;
     * @deny create, update, delete: if false;
     * @principle Allows public access to destination data while restricting modifications.
     */
    match /destinations/{destinationId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to tour package details. Write access is not allowed.
     * @path /tour_packages/{tourPackageId}
     * @allow get, list: if true;
     * @deny create, update, delete: if false;
     * @principle Allows public access to tour package data while restricting modifications.
     */
    match /tour_packages/{tourPackageId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows creation of bookings by any authenticated user. Reads and updates are not allowed.
     * @path /bookings/{bookingId}
     * @allow create: if isSignedIn();
     * @deny get, list, update, delete: if false;
     * @principle Allows any authenticated user to create a booking.
     */
    match /bookings/{bookingId} {
      allow create: if isSignedIn();
      allow get, list, update, delete: if false;
    }

    /**
     * @description Allows creation of reviews by any authenticated user. Reads and updates are not allowed.
     * @path /reviews/{reviewId}
     * @allow create: if isSignedIn();
     * @deny get, list, update, delete: if false;
     * @principle Allows any authenticated user to create a review.
     */
    match /reviews/{reviewId} {
      allow create: if isSignedIn();
      allow get, list, update, delete: if false;
    }

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }
  }
}