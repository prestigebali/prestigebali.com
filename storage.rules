rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow authorized users to upload to the 'package-images' directory
    match /package-images/{allPaths=**} {
      allow read: if true; // Allow public reads so images can be displayed
      allow write: if request.auth != null; // Only authenticated users can write
    }
  }
}
